# Vapi (https://dashboard.vapi.ai) — public key is safe in the browser
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Anthropic (https://console.anthropic.com) — server only
ANTHROPIC_API_KEY=

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vapi private key — server only, used to fetch call recordings
VAPI_PRIVATE_KEY=
