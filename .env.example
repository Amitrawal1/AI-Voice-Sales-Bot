# Self-hosted voice server (voice-server/), reachable from the browser over HTTPS + WebRTC.
NEXT_PUBLIC_VOICE_SERVER_URL=http://localhost:7860
# Shared secret with the voice server (same value as VOICE_SERVER_SECRET in voice-server/.env).
VOICE_SERVER_SECRET=
# Server-side URL of the voice server, used to fetch recordings. Usually the same as above.
VOICE_SERVER_URL=http://localhost:7860

# Sarvam-30B on vLLM (voice-server/scripts/serve_llm.sh), used for the post-call summary and status.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=sarvamai/sarvam-30b

# Optional TURN relay for callers behind strict firewalls (same values as TURN_* in voice-server/.env).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
