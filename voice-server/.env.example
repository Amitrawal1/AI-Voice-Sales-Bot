# Shared secret with the web app (VOICE_SERVER_SECRET there too). Generate with: openssl rand -hex 32
VOICE_SERVER_SECRET=

# The web app. The bot loads the sales prompt from APP_URL/api/agent-config at the start of each call.
APP_URL=http://localhost:3001
# Browser origins allowed to start calls (comma-separated).
ALLOWED_ORIGINS=http://localhost:3001
# Public HTTPS URL of this server, used in recording links.
PUBLIC_URL=http://localhost:7860

# Sarvam-30B on vLLM (scripts/serve_llm.sh). LLM_API_KEY must match the --api-key given to vLLM.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=sarvamai/sarvam-30b

# Whisper-Hindi2Hinglish Apex, converted with scripts/convert_whisper.sh
WHISPER_MODEL_DIR=models/whisper-hindi2hinglish-apex-ct2
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Indic Parler-TTS (gated on Hugging Face: accept the terms, then `huggingface-cli login` or set HF_TOKEN)
TTS_MODEL=ai4bharat/indic-parler-tts
TTS_DEVICE=cuda:0
TTS_CHUNK_SECONDS=0.5
# Optional: override the voice descriptions (see the model card for speaker names)
# TTS_VOICE_EN=
# TTS_VOICE_HI=

# Seconds of caller silence that end their turn (clamped to 0.3–0.5)
VAD_STOP_SECS=0.4

# Optional TURN relay for callers behind strict firewalls (also set NEXT_PUBLIC_TURN_* in the web app)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

DATA_DIR=data
